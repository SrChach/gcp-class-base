# For local MongoDB:
# DATABASE_URL=mongodb://127.0.0.1/your-database-name

# For Firestore with MongoDB Compatibility (SCRAM):
# Make sure to replace <username> and <password> with the actual credentials created in GCP Console.
# Using SCRAM-SHA-256 avoids the need for GCP IAM (account impersonation) or OIDC.
DATABASE_URL="mongodb://<username>:<password>@<your-cluster-id>.nam5.firestore.goog:443/<your-database-name>?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false"

PAYLOAD_SECRET=YOUR_SECRET_HERE

# Configuración de Google Cloud Platform (GCP)
PROJECT_ID=clases-gcp-500802
REGION=northamerica-south1
GAR_REPO_NAME=cloud-run-source-deploy
RUN_SERVICE_NAME=igncursos
IMAGE_NAME=igncursos
IMAGE_TAG=v1
